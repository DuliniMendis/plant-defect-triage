# Copy to .env.local, or run `vercel env pull .env.local` once the project is linked.
# Never commit real values.

# Neon Postgres, set by the Vercel Marketplace integration.
DATABASE_URL=

# Vercel Blob (private store), set when Blob is enabled on the project.
BLOB_READ_WRITE_TOKEN=

# AI Gateway authenticates with Vercel OIDC: VERCEL_OIDC_TOKEN is written by
# `vercel env pull` locally and is automatic on Vercel.
VERCEL_OIDC_TOKEN=

# Model used for triage drafts (docs/evals.md). Leave unset for the default,
# Haiku 5.5; set to anthropic/claude-sonnet-5.5 to compare.
AI_GATEWAY_MODEL=
